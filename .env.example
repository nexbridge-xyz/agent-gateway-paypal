# Copy to .env and fill in. .env is gitignored; never commit real values.
# With nothing set, the app runs fully simulated (same as --demo).

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox).
# In the app, under Payment capabilities, check "Save payment methods" and click Save Changes (see README).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider. Anthropic is used if its key is set; otherwise any OpenAI-compatible API.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     (DeepSeek: https://api.deepseek.com/v1)
# OPENAI_MODEL=gpt-4o-mini

# Hosting (optional). Defaults: 127.0.0.1:8000, opened as http://localhost:8000 or http://127.0.0.1:8000.
# Under any other address the server answers only when BASE_URL names it (other Host names get 421).
# The server has no login: a hosted demo must run with --demo and without real keys (see README).
# HOST=0.0.0.0
# PORT=8000
# BASE_URL=https://your-app.example.com
